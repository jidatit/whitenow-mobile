# TEMPLATE ONLY. Copy to `.env` (git-ignored) and fill in values locally, or set them as
# EAS environment variables. Never commit real values.
#
# Only public Firebase client configuration belongs here: the same six values the web app
# uses (Firebase console > Project settings > Your apps). Never put service-account JSON,
# private keys, or Firebase Admin SDK credentials in this app or this file. EXPO_PUBLIC_*
# values are compiled into the app bundle and are readable by anyone with the app.

# development | preview | production (read by app.config.ts at build time)
APP_VARIANT=development

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Node/Express backend base URL (https in preview and production)
EXPO_PUBLIC_API_BASE_URL=
