{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      // @firebase/auth lists "types" before its "react-native" export condition, so TypeScript
      // picks the browser typings even though Metro bundles dist/rn at runtime. This points the
      // types at the same React Native build Metro uses (it exports getReactNativePersistence).
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/rn/index.rn.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
